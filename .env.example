# ---------------------------------------------------------------------------
# BionicPRO — dev-only environment. Copy to .env: `cp .env.example .env`.
# These are DEVELOPMENT credentials only. Do NOT reuse in production.
# ---------------------------------------------------------------------------

# --- Keycloak (existing) ---------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB_NAME=keycloak_db
KC_DB_USER=keycloak_user
KC_DB_PASSWORD=keycloak_password

# --- CRM database (Bitrix24 stand-in) --------------------------------------
CRM_DB_NAME=crm
CRM_DB_USER=crm_user
CRM_DB_PASSWORD=crm_password

# --- Telemetry database ("the existing database" from the architecture) ----
TELEMETRY_DB_NAME=telemetry
TELEMETRY_DB_USER=telemetry_user
TELEMETRY_DB_PASSWORD=telemetry_password

# --- ClickHouse (OLAP / data mart) -----------------------------------------
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_password

# --- Airflow ---------------------------------------------------------------
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Fixed dev Fernet key so connections survive restarts (dev-only, not secret).
AIRFLOW_FERNET_KEY=Zp8kP3sJ2rN6vY9wQ1xT4uH7bL0cD5eF8gA2mK6nR3s=

# --- Reports API -----------------------------------------------------------
# Issuer as seen by the browser/token (external host). The API fetches JWKS
# via the internal docker hostname (KEYCLOAK_INTERNAL_URL) but validates the
# token's `iss` against this external value.
KEYCLOAK_ISSUER=http://localhost:8080/realms/reports-realm
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=reports-realm
REPORTS_API_AUDIENCE=reports-api
REPORTS_REQUIRED_ROLE=prothetic_user
FRONTEND_ORIGIN=http://localhost:3000
