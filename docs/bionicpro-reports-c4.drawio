<mxfile host="app.diagrams.net" type="device">
  <diagram name="BionicPRO Reports - C4 Container" id="reports-c4">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pilot" value="Пилот протеза&#10;[Person]&#10;Запрашивает отчёт о своём протезе" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="frontend" value="Frontend (SPA)&#10;[React + TypeScript, Keycloak-JS]&#10;Авторизация Code+PKCE; кнопка «Скачать отчёт»; запрос к Reports API с Bearer-токеном" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="keycloak" value="Keycloak&#10;[Identity Provider, realm reports-realm]&#10;Выдаёт JWT (aud=reports-api, роль prothetic_user), публикует JWKS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="api" value="Reports API&#10;[Python + FastAPI]&#10;GET /reports — отдаёт готовый отчёт ТОЛЬКО текущего пользователя; валидирует JWT (JWKS, iss, aud, роль)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" vertex="1" parent="1">
          <mxGeometry x="440" y="220" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="clickhouse" value="ClickHouse&#10;[OLAP]&#10;Витрина marts.user_prosthesis_report&#10;(MergeTree, ключ user_email+protez+дата)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="airflow" value="Airflow (ETL)&#10;[DAG bionicpro_reports_etl]&#10;Ежедневно собирает CRM + телеметрию, строит витрину в ClickHouse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="820" y="420" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="crm" value="CRM DB&#10;[PostgreSQL, стенд-ин Bitrix24]&#10;Клиенты, протезы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="820" y="600" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="telemetry" value="Telemetry DB&#10;[PostgreSQL]&#10;События телеметрии протезов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="820" y="710" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="использует [HTTPS]" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="pilot" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="логин Code+PKCE [OIDC]" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="frontend" target="keycloak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="GET /reports&#10;Bearer JWT [HTTPS/JSON]" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="frontend" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="валидирует подпись&#10;через JWKS [HTTPS]" style="endArrow=block;html=1;fontSize=11;dashed=1;" edge="1" parent="1" source="api" target="keycloak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="SELECT по ключу&#10;user_email [HTTP]" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="api" target="clickhouse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="строит витрину [HTTP]" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="airflow" target="clickhouse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="extract [SQL]" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="airflow" target="crm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="extract [SQL]" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="airflow" target="telemetry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
